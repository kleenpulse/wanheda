# Names only. Real values live in .env.local (ignored) and in Vercel.
# With none of these set, the app runs in demo mode with seed data.

# Neon (eu-central-1). Pooled URL for the app, direct URL for drizzle-kit.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth (Checkpoint 2). Secret: at least 32 random characters.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Who sees the Admin page (users and usage), comma-separated. Anyone can sign up either way.
ADMIN_EMAILS=

# Home board weather (Open-Meteo, no key). All three, or the widget shows a sample.
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_PLACE=

# Seals connector secrets (Polar token, webhook secret). 32 random bytes, base64:
#   openssl rand -base64 32
# Without it, connectors are off and Income shows sample data.
CONNECTOR_SEAL_KEY=

# Reader files in a private Cloudflare R2 bucket (all four, or none). Without
# them the reader is local-only: files stay in each device's storage and only
# the library, progress and collections sync.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

NEXT_PUBLIC_APP_URL=
